---
import {ui} from '../../i18n/ui';
interface Props {kind:'tip'|'warning'|'safety'|'summary'|'checklist'}
const {kind}=Astro.props; const t=ui[((Astro.locals as {lang?:'en'|'ar'}).lang ?? (Astro.currentLocale==='ar'?'ar':'en'))];
---
<aside class:list={['callout',kind]}><strong class="callout-label"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 5v6m0 2v2"/></svg> {t[kind]}</strong><slot/></aside>
